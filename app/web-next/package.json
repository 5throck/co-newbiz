{
  "name": "co-newbiz-web-next",
  "version": "0.0.1",
  "private": true,
  "description": "co-newbiz web + API (Next.js/Prisma). System of record as of Phase 5 cutover (ADR-0069/0070). Runs on port 8787. IMPORTANT: db/client.ts imports bun:sqlite, so next must run under the Bun runtime — the dev/start scripts pass --bun; a bare `next start` under Node fails on every DB route.",
  "scripts": {
    "dev": "bun --bun next dev -p 8787",
    "build": "next build",
    "start": "bun --bun next start -p 8787",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "lint:design": "bun scripts/design-lint.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "marked": "^18.0.12",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  }
}
