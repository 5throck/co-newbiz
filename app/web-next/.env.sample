# app/web-next env — loaded by the Next.js server (bun --bun next).
# See the root .env.sample for the full annotated list.

DATABASE_URL=
CO_NEWBIZ_DB_PATH=

# Market-sizing pipeline LLM (systematic-market-sizing, /market S1).
# When CO_NEWBIZ_LLM_API_KEY/MODEL are set, new industry analyses are
# summarized by the LLM; otherwise deterministic synthesis is used.
# CO_NEWBIZ_LLM_PROVIDER=openai-compatible   # openai-compatible | anthropic | gemini | custom | none
# CO_NEWBIZ_LLM_BASE_URL=https://api.example.com/v1
# CO_NEWBIZ_LLM_API_KEY=your_llm_api_key_here
# CO_NEWBIZ_LLM_MODEL=your-model-name

# Committee deliberation agent mode (ADR-0097 §5): "deterministic" (default —
# local role templates, no LLM) or "llm" (requires the CO_NEWBIZ_LLM_* block
# above; registered at server bootstrap, falls back to deterministic when the
# LLM client is not configured or fails mid-deliberation).
# CO_NEWBIZ_COMMITTEE_AGENTS=deterministic
