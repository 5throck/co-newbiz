# app/web-next env — loaded by the Next.js server (bun --bun next).
# See the root .env.sample for the full annotated list.

DATABASE_URL=
CO_NEWBIZ_DB_PATH=

# Market-sizing pipeline LLM (systematic-market-sizing, /market S1).
# When CO_NEWBIZ_LLM_API_KEY/MODEL are set, new industry analyses are
# summarized by the LLM; otherwise deterministic synthesis is used.
# CO_NEWBIZ_LLM_PROVIDER=openai-compatible   # openai-compatible | anthropic | gemini | custom | none
# CO_NEWBIZ_LLM_BASE_URL=https://api.example.com/v1
# CO_NEWBIZ_LLM_API_KEY=your_llm_api_key_here
# CO_NEWBIZ_LLM_MODEL=your-model-name

# Committee deliberation (ADR-0097 §5, ADR-0196 decision 10): meetings convene
# only when the CO_NEWBIZ_LLM_* block above is configured — there is no mode
# env var; agent_team/hybrid sessions refuse with llm_required otherwise.

# S8 business-case generator executor (ADR-0098 seam): "deterministic"
# (default — seeded reproducible numbers + templated prose, real rows) or
# "llm" (LLM enriches the prose around the SAME computed numbers; persistence
# and all quantitative results stay deterministic — a spec change never comes
# from the model).
# CO_NEWBIZ_BUSINESS_CASE_AGENTS=deterministic

# S9 DD checklist tailor executor (ADR-0099 §2 seam): "deterministic"
# (default — profile-derived items, unsourced/grade C per ADR-0099 §6) or
# "llm" (industry-tailored item proposals; sources stay unsourced/C — the LLM
# is never trusted to cite).
# CO_NEWBIZ_DD_TAILOR_AGENTS=deterministic

# Optional web-search providers (names only; chain order Tavily -> Brave -> Serper -> DuckDuckGo,
# a provider without its key is skipped; quota or bot-block failures pause that provider for 10 minutes):
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# WEB_SEARCH_DDG_ENABLED=true
# Headless Chrome last resort for the S3 holding check (names only): CHROME_PATH = Chrome binary, opt out with false.
# CHROME_PATH=
# WEB_SEARCH_PLAYWRIGHT_ENABLED=true
