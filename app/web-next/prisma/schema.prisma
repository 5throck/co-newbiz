generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model analysis_task {
  id               String     @id
  project_id       String
  deliverable_type String
  reviewed_by      String?
  reviewed_at      String?
  md_project       md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_analysis_task_project")
}

model antitrust_finding {
  id                     String     @id
  project_id             String
  market_definition      String
  hhi_before             Float?
  hhi_after              Float?
  combination_type       String?
  filing_jurisdictions   String?
  remedy_type            String     @default("none")
  remedy_detail          String?
  discharge_confirmed_at String?
  created_at             String
  md_project             md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_antitrust_finding_project")
}

model api_token {
  id           String   @id
  user_id      String
  token_hash   String   @unique(map: "sqlite_autoindex_api_token_2")
  label        String
  scopes       String
  created_at   String
  last_used_at String?
  revoked_at   String?
  app_user     app_user @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_api_token_user")
}

model app_user {
  id                   String             @id
  user_id              String             @unique(map: "sqlite_autoindex_app_user_2")
  display_name         String?
  role                 String
  status               String
  password_salt        String
  password_hash        String
  password_iterations  Int
  must_change_password Int                @default(0)
  failed_attempts      Int                @default(0)
  locked_until         String?
  wall_group           String?
  created_at           String
  approved_by          String?
  approved_at          String?
  api_token            api_token[]
  app_user_human_role  app_user_human_role[]
  password_history     password_history[]
  session              session[]

  @@index([status, user_id], map: "idx_app_user_status")
}

/// ADR-0186 D6 (migration 0176): human-role grants, deny-by-default; rows are revoked, never deleted.
model app_user_human_role {
  id         String   @id
  user_id    String
  role_key   String
  granted_by String
  granted_at String
  revoked_at String?
  revoked_by String?
  app_user   app_user @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, revoked_at], map: "idx_app_user_human_role_user")
}

model approval_chain {
  id                    String     @id
  project_id            String
  level                 String
  gate                  String
  sequence              Int
  required_procedure_id String?
  approver_role         String
  entity_id             String?
  status                String
  decision              String?
  decided_at            String?
  conditions            String?
  blocked_reason        String?
  created_at            String
  updated_at            String
  recorded_by           String?
  decided_by            String?
  gate_decision_id      String?
  decision_reason       String?
  md_entity             md_entity? @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project            md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, level, sequence], map: "idx_approval_chain_project")
}

model assumption {
  id             String  @id
  run_id         String
  assumption_key String
  kind           String
  value          Float
  rationale      String?
  anchor_ref     String?
  as_of          String
  ttl_days       Int?

  @@index([run_id, assumption_key], map: "idx_assumption_run")
}

model audit_log {
  id            String @id
  actor_user_id String
  action        String
  target        String
  created_at    String

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "idx_audit_log_created_at")
  @@index([actor_user_id, created_at(sort: Desc)], map: "idx_audit_log_actor")
}

model benefit_item {
  id                   String     @id
  project_id           String
  category             String
  target_value         Float?
  acquirer_value       Float?
  per_capita_delta     Float?
  harmonization_cost   Float?
  statutory_constraint String?
  md_project           md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_benefit_item_project")
}

model certification {
  id                                                                         String               @id
  project_id                                                                 String
  name                                                                       String
  agency                                                                     String?
  statutory_days                                                             Int?
  status                                                                     String               @default("not_started")
  transferability_basis                                                      String?
  transferable_on_coc                                                        String?
  transferability_evidence_ref                                               String?
  load_bearing                                                               Int                  @default(0)
  confirmed_at                                                               String?
  md_project                                                                 md_project           @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certification_edge_certification_edge_to_certification_idTocertification   certification_edge[] @relation("certification_edge_to_certification_idTocertification")
  certification_edge_certification_edge_from_certification_idTocertification certification_edge[] @relation("certification_edge_from_certification_idTocertification")

  @@index([project_id], map: "idx_certification_project")
}

model certification_edge {
  from_certification_id                                                 String
  to_certification_id                                                   String
  certification_certification_edge_to_certification_idTocertification   certification @relation("certification_edge_to_certification_idTocertification", fields: [to_certification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certification_certification_edge_from_certification_idTocertification certification @relation("certification_edge_from_certification_idTocertification", fields: [from_certification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([from_certification_id, to_certification_id])
}

model chain_node_sensitivity {
  id              String          @id
  project_id      String
  industry_id     String
  driver_id       String
  sensitivity     Float
  lag_months      Int             @default(0)
  evidence_ref    String?
  assessed_by     String
  assessed_at     String
  industry_driver industry_driver @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_industry     md_industry     @relation(fields: [industry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project      md_project      @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([project_id, industry_id, driver_id], map: "sqlite_autoindex_chain_node_sensitivity_2")
  @@index([project_id], map: "idx_chain_node_sensitivity_project")
}

model comp_benchmark {
  id                String     @id
  project_id        String
  job_family        String
  grade             String
  headcount         Int
  target_median     Int
  acquirer_median   Int
  gap_pct           Float
  annual_cost_delta Int
  evidence_ref      String?
  md_project        md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, job_family], map: "idx_comp_benchmark_project")
}

model compliance_check {
  id                            String                       @id
  project_id                    String
  gate                          String
  rule_key                      String
  layer                         String
  result                        String
  detail                        String?
  waiver_id                     String?
  detected_at                   String
  resolved_at                   String?
  invalidated_at                String?
  invalidated_by_classification String?
  project_case_classification   project_case_classification? @relation(fields: [invalidated_by_classification], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project                    md_project                   @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, gate], map: "idx_compliance_check")
}

model contingent_liability {
  id                   String     @id
  project_id           String
  category             String
  description          String?
  probability          Float
  amount_low           Int
  amount_expected      Int
  amount_high          Int
  distribution         String     @default("triangular")
  expected_timing_year Int        @default(0)
  evidence_ref         String?
  value_impact         Int?
  md_project           md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_contingent_liability_project")
}

model covenant_test {
  simulation_id   String
  period_id       String
  covenant_key    String
  threshold       Float
  projected_value Float
  breached        Int        @default(0)
  simulation      simulation @relation(fields: [simulation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([simulation_id, period_id, covenant_key])
}

model data_access_log {
  id         String  @id
  user_id    String
  table_key  String
  record_ref String
  project_id String?
  action     String
  at         String
  ip         String?

  @@index([user_id, at(sort: Desc)], map: "idx_data_access_log_user")
}

model data_change_log {
  id          String @id
  series_id   String
  detected_at String
  change_type String
  old_value   Float?
  new_value   Float?

  @@index([series_id, detected_at(sort: Desc)], map: "idx_change_log_series")
}

model dd_finding {
  id                       String     @id
  project_id               String
  category                 String
  description              String
  value_impact             Int?
  assumption_key           String?
  evidence_ref             String?
  trl_grade                String?
  ip_ownership_status      String?
  commercialization_path   String?
  parent_relationship_json String?
  rbd_source               String?
  created_at               String
  md_project               md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_dd_finding_project")
}

model deal_shape_evaluation {
  id           String     @id
  project_id   String
  shape        String
  intent       String
  viable       Int
  evaluated_by String
  evaluated_at String
  md_project   md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_deal_shape_evaluation_project")
}

model deal_structure_hypothesis {
  id                         String     @id
  project_id                 String
  run_id                     String?
  asset_or_stock             String?
  stake_type                 String?
  instrument_mix             String?
  vehicle                    String?
  commercialization_path     String?
  tax_structure_note         String?
  liability_isolation_note   String?
  financing_leverage_note    String?
  exit_structure_note        String?
  four_axis_review_completed Int        @default(0)
  hypothesized_by            String
  hypothesized_at            String
  rationale                  String
  run                        run?       @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project                 md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model debt_instrument {
  id               String       @id
  project_id       String
  lender           String?
  principal        Int
  currency_id      String?
  rate_type        String
  rate             Float
  maturity         String?
  amortization     String?
  covenant_json    String?
  coc_acceleration Int          @default(0)
  security         String?
  seniority        String?
  md_currency      md_currency? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project       md_project   @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_debt_instrument_project")
}

model dimension_input {
  id                    String            @id
  run_id                String
  project_id            String
  var_key               String
  value_kind            String
  value_text            String?
  value_num             Decimal?
  unit                  String?
  evidence_ref          String
  asserted_by           String
  reviewed_by           String?
  rationale             String
  observed_at           String
  superseded_by         String?
  dimension_input       dimension_input?  @relation("dimension_inputTodimension_input", fields: [superseded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_dimension_input dimension_input[] @relation("dimension_inputTodimension_input")
  evidence_var          evidence_var      @relation(fields: [var_key], references: [var_key], onDelete: NoAction, onUpdate: NoAction)
  md_project            md_project        @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run                   run               @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([project_id, var_key], map: "idx_dimension_input_live", where: raw("superseded_by IS NULL"))
  @@index([project_id, observed_at(sort: Desc)], map: "idx_dimension_input_project")
}

model document {
  id                    String     @id
  run_id                String
  version               Int        @default(1)
  superseded_by         String?
  document_section_hash String?
  created_at            String
  document              document?  @relation("documentTodocument", fields: [superseded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_document        document[] @relation("documentTodocument")
  run                   run        @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([run_id], map: "idx_document_run")
}

model evidence_var {
  var_key                   String                      @id
  label_ko                  String
  value_type                String
  unit                      String?
  source_kind               String
  requires_evidence_ref     Int                         @default(0)
  max_age_days              Int?
  created_at                String
  dimension_input           dimension_input[]
  project_variable_snapshot project_variable_snapshot[]
  rag_rule_variable         rag_rule_variable[]
}

model fact_financial {
  id          String     @id
  company_id  String
  period_id   String
  account_id  String
  value       Float
  revision_no Int        @default(1)
  source_id   String?
  created_at  String
  md_source   md_source? @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_account  md_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_period   md_period  @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_company  md_company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, period_id, account_id, revision_no(sort: Desc)], map: "idx_fact_financial_latest")
}

model fact_industry {
  id          String      @id
  industry_id String
  period_id   String
  metric_key  String
  value       Float
  revision_no Int         @default(1)
  source_id   String?
  created_at  String
  md_source   md_source?  @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_period   md_period   @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_industry md_industry @relation(fields: [industry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([industry_id, period_id], map: "idx_fact_industry_ind")
}

model fact_market_observation {
  series_id    String
  period_id    String
  revision_no  Int
  value        Float
  unit_id      String
  source_id    String
  content_hash String
  fetched_at   String
  md_source    md_source @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_unit      md_unit   @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_period    md_period @relation(fields: [period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([series_id, period_id, revision_no])
  @@index([series_id, period_id(sort: Desc)], map: "idx_obs_latest")
}

model fx_policy {
  id               String  @id
  scope            String
  rate_type        String
  source_series_id String?
  created_at       String
}

model governance_doc {
  id                   String           @id
  layer                String
  key                  String
  title                String
  scope                String           @default("shared")
  entity_id            String?
  region_code          String?
  version              String
  enforceability       String
  owner_agent          String
  doc_path             String
  effective_from       String
  superseded_by        String?
  review_cycle_months  Int?
  governance_doc       governance_doc?  @relation("governance_docTogovernance_doc", fields: [superseded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_governance_doc governance_doc[] @relation("governance_docTogovernance_doc")
  md_entity            md_entity?       @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interpretation       interpretation[]
  rag_rule             rag_rule[]
  waiver               waiver[]

  @@index([layer, key], map: "idx_governance_doc_key")
}

model governance_kpi {
  id         String  @id
  period_id  String
  entity_id  String?
  metric_key String
  value      Float
  note       String?

  @@index([period_id, metric_key], map: "idx_governance_kpi_period")
}

model group_agenda {
  id                 String     @id
  cycle              String
  project_id         String
  entity_id          String?
  submitted_at       String
  capital_request    Float
  irr_over_hurdle_pp Float?
  rag_grade          String?
  priority_rank      Int?
  decision           String?
  rationale          String?
  md_entity          md_entity? @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project         md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cycle, priority_rank], map: "idx_group_agenda_cycle")
}

model incentive {
  id                    String       @id
  project_id            String
  site_id               String?
  direction             String
  type                  String
  grantor               String?
  program_name          String?
  amount                Int?
  npv_value             Int?
  currency_id           String?
  granted_on            String?
  application_deadline  String?
  construction_deadline String?
  obligation_json       String?
  clawback_rule         String?
  estimated_clawback    Int?
  negotiability         String?
  status                String       @default("prospective")
  evidence_ref          String?
  md_currency           md_currency? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project            md_project   @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_incentive_project")
}

model industry_driver {
  id                     String                   @id
  code                   String                   @unique(map: "sqlite_autoindex_industry_driver_2")
  label_ko               String
  description            String?
  source_series_id       String?
  created_at             String
  chain_node_sensitivity chain_node_sensitivity[]
  md_source              md_source?               @relation(fields: [source_series_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model insider_list {
  project_id      String
  user_id         String
  added_at        String
  removed_at      String?
  reason          String
  acknowledged_at String?
  md_project      md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([project_id, user_id])
}

model interpretation {
  id                   String           @id
  governance_doc_id    String
  clause_ref           String
  question             String
  answer               String
  asked_by             String
  answered_by          String
  answered_at          String
  supersedes           String?
  published            Int              @default(0)
  interpretation       interpretation?  @relation("interpretationTointerpretation", fields: [supersedes], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_interpretation interpretation[] @relation("interpretationTointerpretation")
  governance_doc       governance_doc   @relation(fields: [governance_doc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([governance_doc_id, clause_ref], map: "idx_interpretation")
}

model job_run {
  id          String  @id
  job_key     String
  started_at  String
  finished_at String?
  status      String
  error       String?

  @@index([job_key, started_at(sort: Desc)], map: "idx_job_run_key")
}

model jv_term {
  id                 String            @id
  project_id         String
  partner_id         String
  equity_split       String?
  governance_json    String?
  veto_matters       String?
  contribution_json  String?
  exit_clause        String?
  deadlock_mechanism String?
  non_compete_scope  String?
  partner_candidate  partner_candidate @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project         md_project        @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_jv_term_project")
}

model kill_criteria_evaluation {
  id                String     @id
  run_id            String
  project_id        String
  procedure_key     String
  criterion_id      String
  action            String
  outcome           String
  predicate_json    String
  policy_id         String
  thresholds_source String
  evaluated_at      String
  evaluated_by      String
  md_project        md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run               run        @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([run_id, procedure_key, criterion_id], map: "sqlite_autoindex_kill_criteria_evaluation_2")
  @@index([project_id, evaluated_at(sort: Desc)], map: "idx_kill_criteria_eval_project")
}

model management_package {
  id                      String     @id
  project_id              String
  executive_ref           String
  role_title              String
  base_pay                Int
  coc_trigger             Int        @default(0)
  coc_payout_estimate     Int?
  accelerated_vesting     Int        @default(0)
  non_compete_months      Int?
  non_compete_enforceable Int?
  retention_plan_cost     Int?
  flight_risk             String?
  value_impact            Int?
  evidence_ref            String?
  md_project              md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_management_package_project")
}

model md_account {
  id             String           @id
  ifrs_code      String           @unique(map: "sqlite_autoindex_md_account_2")
  name_ko        String
  name_en        String
  created_at     String
  fact_financial fact_financial[]
}

model md_company {
  id             String           @id
  dart_corp_code String?          @unique(map: "idx_md_company_dart", where: raw("dart_corp_code IS NOT NULL"))
  biz_reg_no     String?
  lei            String?
  name_ko        String
  name_en        String?
  created_at     String
  fact_financial fact_financial[]
}

model md_country {
  id         String @id
  iso_code   String @unique(map: "sqlite_autoindex_md_country_2")
  created_at String
}

model md_currency {
  id              String            @id
  iso_code        String            @unique(map: "sqlite_autoindex_md_currency_2")
  created_at      String
  debt_instrument debt_instrument[]
  incentive       incentive[]
}

model md_entity {
  id             String           @id
  entity_code    String           @unique(map: "sqlite_autoindex_md_entity_2")
  name_ko        String
  created_at     String
  approval_chain approval_chain[]
  governance_doc governance_doc[]
  group_agenda   group_agenda[]
}

model md_industry {
  id                                                              String                        @id
  ksic_code                                                       String?                       @unique(map: "idx_md_industry_ksic")
  naics_code                                                      String?
  isic_code                                                       String?
  name_ko                                                         String
  name_en                                                         String
  created_at                                                      String
  chain_node_sensitivity                                          chain_node_sensitivity[]
  fact_industry                                                   fact_industry[]
  project_industry                                                project_industry[]
