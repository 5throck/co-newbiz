  correlation                                                Float?
  r2                                                         Float?
  pass_through_rate                                          Float?
  pass_through_lag_months                                    Int?
  concentration_hhi                                          Float?
  switching_cost_grade                                       String?
  substitution_threat                                        String?
  evidence_ref                                               String?
  assessed_at                                                String
  md_industry_value_chain_link_to_industry_idTomd_industry   md_industry @relation("value_chain_link_to_industry_idTomd_industry", fields: [to_industry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_industry_value_chain_link_from_industry_idTomd_industry md_industry @relation("value_chain_link_from_industry_idTomd_industry", fields: [from_industry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project                                                 md_project  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_value_chain_link_project")
}

model venture_scorecard {
  id               String     @id
  run_id           String
  project_id       String
  source_procedure String
  review_cycle     String
  venture_class    String
  section          String
  measure_key      String
  target_value     String?
  actual_value     String?
  status           String
  evidence_ref     String
  observed_at      String
  created_at       String
  md_project       md_project @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run              run        @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([run_id, source_procedure, section, measure_key], map: "sqlite_autoindex_venture_scorecard_2")
  @@index([review_cycle, section], map: "idx_venture_scorecard_rollup")
  @@index([project_id, review_cycle], map: "idx_venture_scorecard_project")
}

model waiver {
  id                String         @id
  project_id        String
  governance_doc_id String
  clause_ref        String
  reason            String
  requested_by      String
  approver_role     String
  approved_by       String?
  approved_at       String?
  expires_at        String
  status            String
  created_at        String
  governance_doc    governance_doc @relation(fields: [governance_doc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  md_project        md_project     @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, status], map: "idx_waiver_project")
  @@index([governance_doc_id, clause_ref], map: "idx_waiver_clause")
}

model watch {
  id              String       @id
  project_id      String
  user_id         String
  last_checked_at String?
  created_at      String
  md_project      md_project   @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  watch_rule      watch_rule[]

  @@index([project_id], map: "idx_watch_project")
}

model watch_rule {
  id             String @id
  watch_id       String
  trigger_type   String
  threshold      Float?
  cooldown_hours Int    @default(24)
  channel        String
  enabled        Int    @default(1)
  watch          watch  @relation(fields: [watch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([watch_id], map: "idx_watch_rule_watch")
}

/// ADR-0186 D1 (migration 0173): the acknowledged-GO snapshot, one per decision, append-only (triggers reject UPDATE/DELETE).
model gate_decision_snapshot {
  decision_id           String  @id
  schema_version        Int
  snapshot_json         String
  snapshot_hash         String
  submitted_hash        String?
  acknowledgements_json String  @default("[]")
  computed_at           String
  engine_versions_json  String
  eval_run_id           String?
  brief_id              String?
}

/// ADR-0186 D9 (migration 0173): the AI gate brief's recommendation, append-only.
model gate_brief_record {
  id                   String  @id
  entity_type          String
  entity_id            String
  gate                 String
  recommended          String?
  confidence           String?
  source               String  @default("synthesis")
  rationale_draft_hash String?
  llm_call_ref         String?
  eval_run_id          String?
  generated_by         String
  generated_at         String

  @@index([entity_type, entity_id, gate, generated_by, generated_at(sort: Desc)], map: "idx_gate_brief_record_entity")
}

/// ADR-0186 D1/D6 (migration 0174): a recorded Group IC override of a binding (halt) kill criterion; rows are revoked, never deleted.
model kill_criteria_override {
  id            String  @id
  entity_type   String
  entity_id     String
  procedure_key String
  criterion_id  String
  reason        String
  issued_by     String
  issued_at     String
  revoked_at    String?
  revoked_by    String?

  @@index([entity_type, entity_id, revoked_at], map: "idx_kill_criteria_override_entity")
}

/// ADR-0186 D4 (migration 0175): a condition precedent attached to an IC GO; cleared by a different reviewer, never deleted.
model condition_precedent {
  id                 String  @id
  project_id         String
  source_decision_id String
  gate               String
  text               String
  clear_by           String
  owner_role         String?
  origin             String  @default("recorder")
  status             String  @default("open")
  created_by         String
  created_at         String
  cleared_by         String?
  cleared_at         String?
  clear_note         String?
  evidence_ref       String?

  @@index([project_id, status], map: "idx_condition_precedent_project")
  @@index([source_decision_id], map: "idx_condition_precedent_source")
}

/// ADR-0186 (migration 0175): the persisted legacy mark for the maker/checker contract; fixed once written.
model gate_integrity_cutoff {
  name               String @id
  max_decision_rowid Int
  created_at         String
}
