{
  "name": "co-newbiz",
  "displayName": "Co Newbiz",
  "description": "New-business-review AI team and system. Owns the regulations, procedures, guidelines and checklists for new business development and their ongoing operation (axis A), implements and maintains them as a system (axis B), and performs the actual deal reviews on top of that (axis C). Covers Green Field (new establishment) and Brown Field (M&A), with proxy-chain demand estimation for industries that have no direct market data.",
  "variant_type": "consulting",
  "status": "beta",
  "promotionHold": {
    "hold": true,
    "reason": "Variant promotion requires explicit user permission (standing directive, 2026-08-29). Readiness gates being green is not an approval.",
    "recordedIn": "PROMOTION_CHECKLIST.md"
  },
  "version": "0.1.0",
  "inherits_common": "templates/common",
  "designDoc": "https://github.com/5throck/ai-workspace-standards/blob/main/docs/designs/2026-08-19-co-newbiz-design_ko.md",
  "specId": "2026-08-19-co-newbiz-design-ko",
  "agent_overrides": {
    "pm": {
      "type": "additive",
      "reason": "PM acts as New Business Review Lead: coordinates four domain leads (functional / technical / industry / region), enforces stage gates including the Entity IC to Group IC chain, approves ADRs, and owns release judgement. Workspace flat PM Gateway is preserved — domain leads are design and review owners, not dispatchers.",
      "since": "2026-08-19",
      "reviewed_by": "architect",
      "overrides": [
        "agent-roster",
        "governance-workflow",
        "dispatch-protocol"
      ]
    }
  },
