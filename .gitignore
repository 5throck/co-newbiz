<!-- WORKSPACE-MANAGED: Git ignore patterns. Content outside this block is preserved during project upgrades. -->
# Secrets — never commit
.env
.env.*
!.env.sample

# Python
.venv/
__pycache__/
*.pyc
*.pyo
dist/
*.egg-info/

# Node.js
node_modules/
.next/
build/

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
*.swp
# Generated IDE rule files (scripts/generate-ide-rules.ts) — regenerable, not committed
.cursorrules
.clauderules

# Local AI settings (personal overrides — never shared)
.claude/settings.local.json
.gemini/settings.local.json
.mcp.local.json

# Crypto / certificates — never commit private key material
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore

# Temp / build artifacts
*.log
*.bak
*.tmp

# Databases
*.sqlite
*.db


# Antigravity/ZCode session-local state (plans, config — never shared)
.zcode/

# Windows reserved device name artifacts (created by git hooks on cmd.exe)
nul
NUL

# --- Sandbox for testing ---
.sandbox/

# Archive directory ignored to save space (local preservation only)
memory/archive/

# Ignore test temp directories
tests/.temp/

# trail's local graph cache (trail-era; design 2026-10-31-graft-trail-migration).
.trail/cache/
.claude/helpers/trail-hooks.cjs
.claude/helpers/trail-statusline.cjs

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# graft helper machine-local override (issue #1048) — untracked by design.
# (graft-era surfaces stay as legacy until the fleet converges — design 2026-10-31-graft-trail-migration)
.claude/helpers/graft.local.json
# tool-owned mirrors (trail-era + graft-era legacy; self-managed, designs 2026-10-02-self-managed-tool-surfaces + 2026-10-31-graft-trail-migration):
.claude/skills/graft/
.agents/skills/graft/
.codex/skills/graft/
.gemini/skills/graft/
.hermes/skills/graft/
.claude/helpers/graft-hooks.cjs
.claude/helpers/graft-statusline.cjs
<!-- /WORKSPACE-MANAGED -->
*.sqlite-shm
*.sqlite-wal

# local databases and archived copies (never commit)
app/web-next/db/data/**
!app/web-next/db/data/_archived-duplicate/.gitkeep

# stray bundler-rebased DB/cache directory (app/db/data/) — created once by the
# dev server via the rebased import.meta path (2026-11-10-db-path-resolver-marker);
# the *.sqlite patterns above miss the json cache, so ignore the directory whole.
app/db/

# render artifacts (report renderer output)
render_out/
.openchrome/

# Playwright MCP debug snapshots/screenshots — ephemeral, not deliverables
.playwright-mcp/
/detail-dart.png
/detail-standard.png

# Docker production deployment — pre-deploy DB backups (deploy-web.ts)
backups/

# Next.js regenerates next-env.d.ts per mode (dev writes .next/dev/types, build
# writes .next/types) — the two variants would flip-flop through every sync.
# Next recreates the file on any dev/build run, so it is not tracked.
app/web-next/next-env.d.ts

# Stray root-level screenshots (evidence lives in docs/evidence/)
/*.png

# bun test --coverage output
coverage/

# SQLite WAL sidecars — runtime artifacts that change on every app run (ADR-0181 follow-up, decider approved 2026-10-18)
db/dev.db-shm
db/dev.db-wal

# Visual smoke (T-20261022-050) — captured screenshots and geometry snapshots are
# ephemeral run artifacts; only the opt-in __screenshots__/ aHash baselines are
# meant to be committed.
tests/e2e-visual/screenshots/

# Scheduler-generated reports (gate-integrity weekly shadow report, ...)
db/data/reports/

# Retention archives (D6: local db/archive/ inside the backed-up volume; never committed)
db/archive/
