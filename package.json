{
  "type": "module",
  "name": "co-newbiz",
  "version": "1.0.0",
  "description": "co-newbiz — new-business-review AI team and system (L3 variant prototype)",
  "scripts": {
    "test": "bun scripts/test-runner.ts unit",
    "test:unit": "bun scripts/test-runner.ts unit",
    "eval": "bun scripts/eval/run.ts",
    "test:e2e": "bun scripts/test-runner.ts scenarios",
    "test:full": "bun run test:unit && bun run test:scripts",
    "verify-skills": "bun scripts/verify-skills.ts",
    "validate-agents": "bun scripts/validate-agents.ts",
    "validate-doc-folder": "bun scripts/validate-doc-folder.ts",
    "validate-skills": "bun scripts/validate-skills.ts",
    "validate:language": "bun scripts/validate-md-language.ts",
    "agent:create": "bun scripts/agent-create.ts",
    "agent:list": "bun scripts/agent-list.ts",
    "agent:delete": "bun scripts/agent-delete.ts",
    "agent:verify": "bun scripts/agent-verify.ts",
    "dispatch:parallel": "bun scripts/dispatch.ts parallel",
    "dispatch:serial": "bun scripts/dispatch.ts serial",
    "audit": "bun scripts/audit.ts",
    "dev-sync": "bun scripts/dev-sync.ts",
    "sync-md": "bun scripts/sync-md.ts",
    "gen-pr-body": "bun scripts/gen-pr-body.ts",
    "qa-gate": "bun scripts/qa-gate.ts",
    "sync-skills": "bun scripts/sync-skills.ts",
    "agent-lifecycle-audit": "bun scripts/agent-lifecycle-audit.ts",
    "skill-lifecycle-audit": "bun scripts/skill-lifecycle-audit.ts",
    "readme-lifecycle-audit": "bun scripts/readme-lifecycle-audit.ts",
    "lifecycle-sync": "bun scripts/lifecycle-sync-audit.ts",
    "translate-readme": "bun scripts/translate-readme.ts",
    "verify-scripts": "bun scripts/verify-scripts.ts",
    "clean:sandbox": "bun -e \"import {rmSync, mkdirSync} from 'node:fs'; rmSync('.sandbox', {recursive:true, force:true}); mkdirSync('.sandbox');\"",
    "design:lint": "bun scripts/co-newbiz/design-lint.ts",
    "mcp:coverage": "bun scripts/co-newbiz/mcp-coverage.ts",
    "runbooks:validate": "bun scripts/co-newbiz/runbook-validate.ts",
    "contrast:check": "bun scripts/co-newbiz/contrast-check.ts",
    "agents:personas": "bun scripts/co-newbiz/sync-agent-personas.ts",
    "glossary:lint": "bun glossary/_validate.ts",
    "procedures:lint": "bun procedures/_validate.ts",
    "checklists:lint": "bun checklists/_validate.ts",
    "db:migrate": "bun scripts/co-newbiz/newbiz.ts db:migrate",
    "db:status": "bun scripts/co-newbiz/newbiz.ts status",
    "db:integrity": "bun scripts/co-newbiz/db-integrity.ts",
    "seed:s1-s12-demo": "bun scripts/co-newbiz/seed-s1-s12-demo.ts",
    "test:integration": "bun scripts/test-runner.ts integration --allow-empty",
    "test:scripts": "bun scripts/test-runner.ts scripts",
    "test:coverage": "mkdir -p coverage tests/.temp/worker-0 && TEST_TEMP_DIR=tests/.temp/worker-0 WORKER_ID=0 bun test --timeout=30000 --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage tests/unit",
    "coverage:check": "bun scripts/coverage-baseline.ts",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && bun scripts/typecheck-baseline.ts",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:baseline": "bun scripts/typecheck-baseline.ts",
    "typecheck:web": "cd app/web-next && tsc --noEmit",
    "lint": "biome check",
    "lint:changed": "biome ci --changed --since=origin/main --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "zod": "4.4.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "private": true
}
