# .env.sample — copy to .env and fill in values
# All variables listed here are required unless marked [optional]

# >>> country-scoped:KR
# Korean Financial Supervisory Service DART OpenAPI key
# Obtain at: https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
DART_API_KEY=your_dart_api_key_here

# Korean Ministry of Government Legislation (MOJ) OpenAPI OC ID
# Sign up at: https://open.law.go.kr/LSO/main.do (Open API > application for use)
LAW_API_OC=your_law_api_oc_here

# Korean Statistical Information Service (KOSIS) Open API key
# Obtain at: https://kosis.kr/openapi/ (Open API > application for use)
KOSIS_API_KEY=your_kosis_api_key_here

# Korea Public Data Portal (data.go.kr) service key
# Used by the k-opendata skill for Korea Customs Service (관세청) HS-code trade statistics
# Obtain at: https://www.data.go.kr/ (마이페이지 > 인증키 확인, after 활용신청 per dataset)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# Bank of Korea Economic Statistics System (ECOS) Open API key
# Used by the k-ecos skill; the public demo key `sample` works for ≤10-row queries
# Obtain at: https://ecos.bok.or.kr (MyPage > 인증키 신청)
ECOS_API_KEY=your_ecos_api_key_here

# Korea Exchange (KRX) Data Marketplace OPEN API key
# Used by the k-krx skill for Korean exchange market data (KOSPI/KOSDAQ/KONEX, ETF/ETN/ELW, indices)
# Obtain at: https://openapi.krx.co.kr (MyPage > API 인증키 신청; administrator approval + per-service usage application required)
KRX_API_KEY=your_krx_api_key_here
# <<< country-scoped:KR

# [KEY_NAME]=[description]
# Example:
# API_KEY=your_api_key_here
# DATABASE_URL=postgresql://user:password@localhost/dbname

# If this project has no environment variables, leave this file with only this comment.

# --- Project-specific variables (preserved by upgrade; not overwritten by template sync) ---
# Korean Ministry of Government Legislation (법제처) OpenAPI OC ID
# Sign up at: https://open.law.go.kr/LSO/main.do (OPEN API > 활용신청)

# South Korea Open Data Portal (공공데이터포털, data.go.kr) Open API service key
# Obtain at: https://www.data.go.kr/ (오픈API > 활용신청)

# co-newbiz MCP server (mcp/co-newbiz/) — docs/mcp-integration.md §2
# Local stdio MCP client only. Base URL of the running co-newbiz web app/API
# (Next.js, app/web-next). Host dev server = port 7748; the Docker production
# container = port 7749 (public https://newbiz.bizknights.org).
CO_NEWBIZ_API_BASE_URL=http://localhost:7748

# Personal API token for the local stdio MCP client. Issue it yourself in the web
# app: Settings > Connected apps > "Personal API tokens" (human web session only;
# the plaintext cnb_pat_... value is shown exactly once). Choose scope read or
# read+write and an expiry (default 30 days, maximum 90; at most 5 active tokens
# per user). Viewer and admin roles cannot get the write scope.
# Hosted AI apps (Claude.ai, ChatGPT) must NOT use a pasted token: they connect
# by OAuth with the connector URL <origin>/api/mcp
# (e.g. https://newbiz.bizknights.org/api/mcp).
CO_NEWBIZ_API_TOKEN=your_co_newbiz_api_token_here

# Web bootstrap migration policy:
#   auto            : apply pending SQLite migrations on server boot (local/dev default)
#   require-current : fail boot if migrations are pending; run `bun run db:migrate` first
#   off             : do not apply or require migrations (diagnostic only)
# Production deployments should prefer require-current so schema changes are
# applied deliberately before `bun --bun next start`.
# CO_NEWBIZ_BOOTSTRAP_MIGRATIONS=auto

# Market-sizing pipeline LLM (systematic-market-sizing, /market S1) — used by
# app/web-next/lib/llm.ts via the Next.js server (put working values in
# app/web-next/.env). When unset, the pipeline falls back to deterministic
# synthesis and the UI labels the output accordingly.
# CO_NEWBIZ_LLM_PROVIDER=openai-compatible   # openai-compatible | anthropic | gemini | custom | none
# CO_NEWBIZ_LLM_BASE_URL=https://api.example.com/v1
# CO_NEWBIZ_LLM_API_KEY=your_llm_api_key_here
# CO_NEWBIZ_LLM_MODEL=your-model-name

# S2/S3 pipeline research sources (app/web-next pipelines):
# TAVILY_API_KEY enables web research (global reports, broker notes, statistics,
# news) with source citation; DART_API_KEY enables financial-statement ingest
# for S3 synergy analyses (listed/externally-audited companies).
# TAVILY_API_KEY=your_tavily_api_key_here
# Also optional (names only): BRAVE_SEARCH_API_KEY, SERPER_API_KEY - chain Tavily -> Brave -> Serper -> DuckDuckGo;
# quota or bot-block failures pause a provider for 10 minutes.
# Last resort for the S3 holding check only (names only): a headless Chrome search after the providers above found
# nothing. CHROME_PATH points at the Chrome binary (platform default otherwise); WEB_SEARCH_PLAYWRIGHT_ENABLED=false turns it off.
# CHROME_PATH=
# WEB_SEARCH_PLAYWRIGHT_ENABLED=true
# Optional S9 tailored-DD provenance mode. When set to tavily and TAVILY_API_KEY is present,
# generated DD proposals attach real source URLs; otherwise they remain deterministic unsourced/C.
# CO_NEWBIZ_DD_TAILOR_AGENTS=tavily

# Extra dev-server hostnames/IPs allowed for HMR and dev chunks (Next
# allowedDevOrigins), added to the built-in list. Comma- or space-separated bare
# hostnames/IPs (no scheme/port). Read from this root .env at dev-server start;
# restart the dev server after editing. Ignored by production builds.
# The built-in list (BUILTIN_DEV_ORIGINS in app/web-next/lib/dev-origins.ts)
# already covers the current hosts (e.g. dev-newbiz.bizknights.org), so only NEW
# hosts need to be added here.
# CO_NEWBIZ_ALLOWED_DEV_ORIGINS=dev-newbiz.bizknights.org,new-host.example.org,100.64.0.10

# Executor agent modes (deterministic by default; "llm" needs the LLM block above).
# CO_NEWBIZ_COMMITTEE_AGENTS=deterministic
# CO_NEWBIZ_BUSINESS_CASE_AGENTS=deterministic

# SQLite file override (default db/data/co-newbiz.sqlite; app/web-next/.env.sample
# also lists it). Leave unset unless you need a different database file.
# CO_NEWBIZ_DB_PATH=/path/to/co-newbiz.sqlite

# ---- Production (.env.prod, read by the Docker container, NOT this file) ----
# The container reads .env.prod (compose env_file), never this root .env.
# Copy these lines into .env.prod (placeholders only; .env.prod stays git-ignored)
# and apply with: docker compose up -d --force-recreate
#
# CO_NEWBIZ_PUBLIC_ORIGIN - REQUIRED in production.
#   Purpose: pins the OAuth issuer and the MCP resource identifier. Unset, the
#   origin is taken from the request Host header, which a spoofed Host can
#   change (Host-spoofing risk; the server logs a boot warning).
#   Format: scheme + host (+ optional port), no path. Default: unset.
#   When to set: always, in production.
# CO_NEWBIZ_PUBLIC_ORIGIN=https://newbiz.bizknights.org
#
# CO_NEWBIZ_MCP_ALLOWED_ORIGINS - optional.
#   Purpose: extra browser Origins allowed to call /api/mcp (the public origin
#   is always allowed). Format: comma list of origins. Default: empty.
#   When to set: only when a browser app on another origin calls /api/mcp.
# CO_NEWBIZ_MCP_ALLOWED_ORIGINS=https://other-app.example.org
#
# CO_NEWBIZ_OAUTH_REDIRECT_HOST_ALLOWLIST - optional.
#   Purpose: hosts permitted as OAuth client redirect targets.
#   Format: comma list of hosts. Default: empty = https or loopback redirects only.
#   When to set: only for OAuth clients redirecting to a non-https, non-loopback host.
# CO_NEWBIZ_OAUTH_REDIRECT_HOST_ALLOWLIST=client.example.org
#
# CO_NEWBIZ_ALLOWED_DEV_ORIGINS is development-server only (set above in this
# file); it is ignored in production, do not put it in .env.prod.
