# .env.sample — copy to .env and fill in values
# All variables listed here are required unless marked [optional]

# >>> country-scoped:KR
# Korean Financial Supervisory Service DART OpenAPI key
# Obtain at: https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
DART_API_KEY=your_dart_api_key_here

# Korean Ministry of Government Legislation (법제처) OpenAPI OC ID
# Sign up at: https://open.law.go.kr/LSO/main.do (OPEN API > 활용신청)
LAW_API_OC=your_law_api_oc_here
# Korean Statistical Information Service (KOSIS) Open API key
# Obtain at: https://kosis.kr/openapi/ (Open API > application for use)
KOSIS_API_KEY=your_kosis_api_key_here
# <<< country-scoped:KR

# co-newbiz MCP server (mcp/co-newbiz/) — docs/mcp-integration.md §2
# Base URL of the running Hono API (app/server/index.ts)
CO_NEWBIZ_API_BASE_URL=http://localhost:8787
# Bearer API token — issue one via POST /api/tokens while logged in to the
# web app, then paste the plaintext value here (it is shown exactly once)
CO_NEWBIZ_API_TOKEN=your_co_newbiz_api_token_here

# [KEY_NAME]=[description]
# Example:
# API_KEY=your_api_key_here
# DATABASE_URL=postgresql://user:password@localhost/dbname

# If this project has no environment variables, leave this file with only this comment.
