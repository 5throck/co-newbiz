// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`launchd rendering (both envs) dev: mandatory keys per design section 7 (snapshot) 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.bizknights.co-newbiz.dev.tick</string>
	<key>ProgramArguments</key>
	<array>
		<string><BUN_BIN>/bun</string>
		<string>scripts/co-newbiz/schedule-tick.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string><REPO_ROOT></string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string><BUN_BIN>:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>CO_NEWBIZ_SCHEDULER_ENV</key>
		<string>dev</string>
	</dict>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>StandardOutPath</key>
	<string><HOME>/Library/Logs/co-newbiz/dev-tick.out.log</string>
	<key>StandardErrorPath</key>
	<string><HOME>/Library/Logs/co-newbiz/dev-tick.err.log</string>
</dict>
</plist>
"
`;

exports[`launchd rendering (both envs) prod: mandatory keys per design section 7 (snapshot) 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.bizknights.co-newbiz.prod.tick</string>
	<key>ProgramArguments</key>
	<array>
		<string><DOCKER_BIN></string>
		<string>exec</string>
		<string>-e</string>
		<string>CO_NEWBIZ_SCHEDULER_ENV=prod</string>
		<string>co-newbiz-web</string>
		<string>bun</string>
		<string>/repo/scripts/co-newbiz/schedule-tick.ts</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string><BUN_BIN>:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>CO_NEWBIZ_SCHEDULER_ENV</key>
		<string>prod</string>
	</dict>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>StandardOutPath</key>
	<string><HOME>/Library/Logs/co-newbiz/prod-tick.out.log</string>
	<key>StandardErrorPath</key>
