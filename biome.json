{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "db/**",
      "mcp/**",
      "scripts/**",
      "tests/**",
      "app/web-next/**",
      "!**/node_modules",
      "!**/.next",
      "!**/render_out",
      "!**/next-env.d.ts",
      "!**/*.generated.*",
      "!**/*.sqlite",
      "!**/bun.lock",
      "!**/package-lock.json",
      "!graft",
      "!backups",
      "!.claude",
      "!.gemini",
      "!app/web-next/prompts",
      "!app/web-next/public",
      "!tests/fixtures",
      "!tests/.temp"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["db/lib/snapshot-filler.ts"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["app/web-next/app/styles.css"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["app/web-next/lib/dart-client.ts"],
      "formatter": { "enabled": false }
    }
  ],
  "assist": { "enabled": false }
}
